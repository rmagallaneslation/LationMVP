# Lation landing page environment example
# Never commit real secrets. Configure production and preview secrets in Vercel.

# Public frontend env
VITE_TURNSTILE_SITE_KEY=
VITE_SUPABASE_URL=
VITE_DEMO_MODE=true

# Optional: only set when the lead API is hosted on another origin.
# If unset, the frontend posts to /api/lead.
VITE_API_URL=

# Server-only env
SUPABASE_SERVICE_ROLE_KEY=
LEADS_TARGET_TABLE=leads_demo
RESEND_API_KEY=
LEAD_NOTIFY_TO=
LEAD_NOTIFY_FROM=Lation Leads <leads@lation.com.mx>
TURNSTILE_SECRET_KEY=
ALLOWED_ORIGINS=https://lation.com.mx,https://www.lation.com.mx

# DEMO should use LEADS_TARGET_TABLE=leads_demo.
# DEV should use LEADS_TARGET_TABLE=leads_dev.
# main/production should use LEADS_TARGET_TABLE=leads.

# Optional distributed rate limit storage.
# If unset, /api/lead falls back to an in-memory per-instance limiter.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
